using System;

namespace Lab1Variant23
{
    class Program
    {
        static void Main()
        {
            int m = ReadInt("Введите число m: ");
            int n = ReadInt("Введите число n: ");
            double x = ReadDouble("Введите число x: ");

            Console.WriteLine();
            Console.WriteLine("Задача 1:");
            Task1(m, n, x);
            Console.WriteLine();

            double x1 = ReadDouble("Введите число x1: ");
            double y1 = ReadDouble("Введите число y1: ");
            bool isIn = IsInArea(x1, y1);
            Console.WriteLine();
            Console.WriteLine("Задача 2: точка (" + x1 + ", " + y1 + ") принадлежит области: " + isIn);

            Console.WriteLine();
            Console.WriteLine("Задача 3:");
            const double a = 1000.0;
            const double b = 0.0001;
            double resD = Task3Double(a, b);
            float resF = Task3Float((float)a, (float)b);
            Console.WriteLine("Double: " + resD);
            Console.WriteLine("Float:  " + resF);
        }

        static int ReadInt(string prompt)
        {
            Console.Write(prompt);
            string line = Console.ReadLine();
            return int.Parse(line);
        }

        static double ReadDouble(string prompt)
        {
            Console.Write(prompt);
            string line = Console.ReadLine();
            return double.Parse(line);
        }

        static void Task1(int m, int n, double x)
        {
            int r1 = --m - n++;
            Console.WriteLine("1) --m - n++ = " + r1 + " (m = " + m + ", n = " + n + ")");

            bool r2 = m * m < n++;
            Console.WriteLine("2) m*m < n++ = " + r2 + " (m = " + m + ", n = " + n + ")");

            bool r3 = n-- > ++m;
            Console.WriteLine("3) n-- > ++m = " + r3 + " (m = " + m + ", n = " + n + ")");

            if (x == 0)
            {
                Console.WriteLine("4) Ошибка: x не может быть равен 0");
            }
            else
            {
                double r4 = 1.0 + 1.0 / x + 1.0 / (x * x);
                Console.WriteLine("4) 1 + 1/x + 1/x^2 = " + r4);
            }
        }

        static bool IsInArea(double x, double y)
        {
            return ((x + 5) * (x + 5) + y * y <= 25) && (x * x + y * y <= 25);
        }
        static double Task3Double(double a, double b)
        {
            double num = Math.Pow(a - b, 3) - (Math.Pow(a, 3) - 3 * Math.Pow(a, 2) * b);
            double den = 3 * a * Math.Pow(b, 2) - Math.Pow(b, 3);
            return num / den;
        }

        static float Task3Float(float a, float b)
        {
            float num = (float)Math.Pow(a - b, 3) - ((float)Math.Pow(a, 3) - 3 * (float)Math.Pow(a, 2) * b);
            float den = 3 * a * (float)Math.Pow(b, 2) - (float)Math.Pow(b, 3);
            return num / den;
        }
    }
}
